PORT=8000
DB_URL=mongodb+srv://user:password@cluster.mongodb.net/dbname
BASE_URL=/backend-api/v1

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# SMTP (Gmail app password recommended)
SMTP_SERVICE=gmail
SMTP_NAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
# Display name shown as the sender (keep it identical to your brand, not a random string)
SMTP_FROM_NAME=Your App Name
# Where replies go; must be a real, monitored inbox
SMTP_REPLY_TO=your-email@gmail.com

# JWT
JWT_ACCESS_SECRET=change_me_access_secret_use_long_random_string
JWT_REFRESH_SECRET=change_me_refresh_secret_use_long_random_string
JWT_TEMP_SECRET=change_me_temp_secret_use_long_random_string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_TEMP_EXPIRES_IN=1h

# App
APP_NAME=Backend App
CLIENT_URL=http://localhost:3000
